# ── API de Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=tu_api_key_aqui

# Modelo LLM usado por el copiloto (único lugar para cambiarlo — ver setup/llm_provider.py).
# Opcional: si se omite, usa el default definido en llm_provider.DEFAULT_MODEL.
LLM_MODEL=gemini-3.6-flash

# ── Base de datos HR (PostgreSQL en contenedor hr-db) ────────────────────────
HR_DB_HOST=hr-db
HR_DB_PORT=5432
HR_DB_NAME=hrcopilot
HR_DB_USER=hruser
HR_DB_PASSWORD=cambia_esta_contraseña_segura

# ── Dominio para Traefik ─────────────────────────────────────────────────────
HR_DOMAIN=hr.jfbernalp.dev

# ── Sesiones Flask ───────────────────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_este_secreto

# ── ChromaDB ─────────────────────────────────────────────────────────────────
USE_CHROMA=1
